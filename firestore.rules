rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMemberOfConversation(conversationId) {
      return isAuthenticated() && (
        conversationId.matches('.*' + request.auth.uid + '.*') ||
        (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds)
      );
    }

    function isValidUser(data) {
      return (!('userId' in data) || (data.userId is string && data.userId.size() > 0)) &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('username' in data) || data.username is string) &&
             (!('phoneNumber' in data) || data.phoneNumber is string) &&
             (!('email' in data) || data.email is string) &&
             (!('onlineStatus' in data) || data.onlineStatus in ['online', 'offline', 'away', 'busy']) &&
             (!('profilePhoto' in data) || data.profilePhoto is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('lastSeen' in data) || data.lastSeen is timestamp);
    }

    function isValidConversation(data) {
      return (!('conversationId' in data) || (data.conversationId is string && data.conversationId.size() > 0)) &&
             (!('participantIds' in data) || (data.participantIds is list && data.participantIds.size() >= 2)) &&
             (!('participantNames' in data) || data.participantNames is map) &&
             (!('participantPhotos' in data) || data.participantPhotos is map) &&
             (!('lastMessage' in data) || data.lastMessage is string) &&
             (!('lastSenderId' in data) || data.lastSenderId is string) &&
             (!('lastMessageTime' in data) || data.lastMessageTime is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidMessage(data) {
      return (!('messageId' in data) || (data.messageId is string && data.messageId.size() > 0)) &&
             (!('conversationId' in data) || (data.conversationId is string && data.conversationId.size() > 0)) &&
             (!('senderId' in data) || (data.senderId is string && data.senderId.size() > 0)) &&
             (!('messageText' in data) || data.messageText is string) &&
             (!('receiverId' in data) || data.receiverId is string) &&
             (!('messageType' in data) || data.messageType in ['text', 'emoji', 'image', 'video', 'file', 'voice', 'audio']) &&
             (!('status' in data) || data.status in ['sending', 'sent', 'delivered', 'seen']) &&
             (!('replyToMessageId' in data) || data.replyToMessageId is string) &&
             (!('replyToSenderName' in data) || data.replyToSenderName is string) &&
             (!('replyToContent' in data) || data.replyToContent is string) &&
             (!('mediaFileName' in data) || data.mediaFileName is string) &&
             (!('mediaFileSize' in data) || data.mediaFileSize is string) &&
             (!('mediaDuration' in data) || data.mediaDuration is int) &&
             (!('mediaUrl' in data) || data.mediaUrl is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('deliveredAt' in data) || data.deliveredAt is timestamp) &&
             (!('seenAt' in data) || data.seenAt is timestamp);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;

      match /contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        conversationId.matches('.*' + request.auth.uid + '.*') ||
        (resource != null && request.auth.uid in resource.data.participantIds)
      );
      allow create: if isAuthenticated() && 
                    (conversationId.matches('.*' + request.auth.uid + '.*') ||
                     request.auth.uid in request.resource.data.participantIds) &&
                    isValidConversation(request.resource.data);
      allow update: if isAuthenticated() && 
                    (conversationId.matches('.*' + request.auth.uid + '.*') ||
                     (resource != null && request.auth.uid in resource.data.participantIds)) &&
                    isValidConversation(request.resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMemberOfConversation(conversationId);
        allow create: if isMemberOfConversation(conversationId) && 
                      request.resource.data.senderId == request.auth.uid &&
                      isValidMessage(request.resource.data);
        allow update: if isMemberOfConversation(conversationId) && 
                      isValidMessage(request.resource.data);
        allow delete: if false;
      }

      match /typing/{typingUserId} {
        allow read: if isMemberOfConversation(conversationId);
        allow write: if isMemberOfConversation(conversationId) && request.auth.uid == typingUserId;
      }
    }

    match /calls/{callId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.callerId;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId
      );
      allow delete: if false;

      match /candidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
